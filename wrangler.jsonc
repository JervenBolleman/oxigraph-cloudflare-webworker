{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oxigraph-cloudflare-webworker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "vars": {
    // URL of the RDF file to load into the in-memory Oxigraph store.
    // Replace this with the URL of your own static file before deploying,
    // or create a separate named worker with `npm run new-worker` (see
    // README.md).
    "DATA_URL": "https://example.com/data.ttl",
    // Media type of DATA_URL, one of those in src/formats.json (e.g.
    // "text/turtle", "application/n-triples"). Leave empty to go by its file
    // extension (optionally followed by .gz), or for a URL without one, by
    // the Content-Type it is served with.
    "DATA_FORMAT": "",
    // Accept header sent when fetching DATA_URL. Leave empty to ask for the
    // format above.
    "DATA_ACCEPT": "",
    // URL of a stylesheet for the SPARQL editor page that browsers get from
    // /sparql without a query. Replaces the minimal default CSS (see
    // src/editor-page.ts). Leave empty to keep the default.
    "EDITOR_CSS_URL": ""
  }
}
